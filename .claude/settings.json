{
  "_comment": "Bash(git push:*) は雛形（fermentary/tools/gh-review/settings.json）どおり allow。force 系と --delete / --mirror は ask にも残すが、権限パターンは前方一致なので git push origin --force のようにフラグが push の直後に来ない語順を拾えない。語順に依存しない判定は PreToolUse フック guard-force-push.sh が持ち、コマンド全文を見て ask へ回す。ask の列挙はフックを切ったときの下限として残してある（CLAUDE.md「git」節・fermentary RULES.md #5）。判定の口は pnpm check の一本（docs/adr/0009-pnpm-check.md）。check を構成する個別スクリプトも allow に置く——切り分けのために単体で叩くので、置かないと毎回訊かれるだけの摩擦になる。mise はランタイム版管理として残っており（install / 参照系）、tasks は持たない。",
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(mise install)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise where:*)",
      "Bash(pnpm install)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-force-push.sh",
            "if": "Bash(git push:*)",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "リモート環境を準備中"
          }
        ]
      }
    ]
  }
}
