{
  "_comment": "Bash(git push:*) は共有の雛形どおり allow。force 系と --delete / --mirror は ask にも残すが、権限パターンは前方一致なので git push origin --force のようにフラグが push の直後に来ない語順を拾えない。語順に依存しない判定は PreToolUse フック guard-force-push.sh が持ち、コマンド全文を見て ask へ回す。フックの if を git 全体で絞ってあるのは、コマンド名より細かいパターンが $( ) を含む行を素通しさせて起動する（hooks のドキュメント）ためで、git push:* と書いても絞りにならないから。ask の列挙はフックを切ったときの下限として残してある（CLAUDE.md「git」節）。判定の口は pnpm check の一本（docs/adr/0009-pnpm-check.md）。check を構成する個別スクリプトも allow に置く——切り分けのために単体で叩くので、置かないと毎回訊かれるだけの摩擦になる。mise はランタイム版管理として残っており（install / 参照系）、tasks は持たない。gh は雛形どおり全器共通の三層で配る——読み取り・起票・コメント・close までが allow、merge と release と api が ask、repo の削除／編集と secret と auth が deny。切り分けの理由は CLAUDE.md「git」節が持つ。",
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(mise install)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise where:*)",
      "Bash(pnpm install)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-force-push.sh",
            "if": "Bash(git:*)",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "リモート環境を準備中"
          }
        ]
      }
    ]
  }
}
