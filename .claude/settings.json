{
  "_comment": "器固有の逸脱: 雛形（fermentary/tools/gh-review/settings.json）と playbooks/remote-settings-placement.md の検査点が allow に置く Bash(git push:*) を、この器では ask に落としている。CLAUDE.md が push を手元の既定で人間のみと定めており、allow へ移すと手元でも無言で push が通って規約と設定が食い違う。リモートでは毎回訊かれる摩擦が残るが、摩擦であって破れではない。判定の口は mise run check の一本（docs/plan.md §1）なので、pnpm の個別スクリプトは名指ししない。",
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(mise run check)",
      "Bash(mise run lint)",
      "Bash(mise run format)",
      "Bash(mise run build)",
      "Bash(mise install)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise where:*)",
      "Bash(pnpm install)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "リモート環境を準備中"
          }
        ]
      }
    ]
  }
}
