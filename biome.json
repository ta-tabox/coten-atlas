{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["**", "!**/.next", "!**/out", "!**/next-env.d.ts"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "proseWrap": "preserve"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended",
      "react": "recommended",
      "next": "recommended"
    },
    "rules": {
      "style": {
        "noNestedTernary": "error",
        "noMultiAssign": "error",
        "useSingleVarDeclarator": "error",
        "useBlockStatements": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**", "!./**/*.css", "!../**/*.css"],
                "message": "import は @ 起点の絶対パスで書く（.claude/rules/languages/typescript.md「import」節）"
              },
              {
                "group": ["node:fs", "node:fs/promises"],
                "message": "node:fs を import してよいのは src/lib/catalog-dir.*・scripts/**・tests/** だけ（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
              },
              {
                "group": ["maplibre-gl", "react-map-gl/maplibre"],
                "message": "maplibre-gl・react-map-gl/maplibre を import してよいのは src/components/map/MapCanvas.tsx・src/components/map/SeriesLayers.tsx・src/lib/map/series-layer.ts・src/components/admin/AnchorDragMap.tsx だけ（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "warn",
          "options": {
            "max": 3
          }
        }
      },
      "suspicious": {
        "useErrorMessage": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/CLAUDE.md", "**/.claude/**", "**/.github/**/*.md"],
      "markdown": {
        "formatter": {
          "enabled": false
        }
      }
    },
    {
      "includes": ["web/vitest.config.ts", "web/next.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["web/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**", "!./**/*.css", "!../**/*.css"],
                    "message": "import は @ 起点の絶対パスで書く（.claude/rules/languages/typescript.md「import」節）"
                  },
                  {
                    "group": ["node:fs", "node:fs/promises"],
                    "message": "node:fs を import してよいのは src/lib/catalog-dir.*・scripts/**・tests/** だけ（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  },
                  {
                    "group": ["maplibre-gl", "react-map-gl/maplibre"],
                    "message": "maplibre-gl・react-map-gl/maplibre を import してよいのは src/components/map/MapCanvas.tsx・src/components/map/SeriesLayers.tsx・src/lib/map/series-layer.ts・src/components/admin/AnchorDragMap.tsx だけ（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  },
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "依存は src/app から src/lib への一方向なので、src/lib から src/app を import しない（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "web/src/lib/catalog-dir.*",
        "web/scripts/**",
        "web/tests/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**", "!./**/*.css", "!../**/*.css"],
                    "message": "import は @ 起点の絶対パスで書く（.claude/rules/languages/typescript.md「import」節）"
                  },
                  {
                    "group": ["maplibre-gl", "react-map-gl/maplibre"],
                    "message": "maplibre-gl・react-map-gl/maplibre を import してよいのは src/components/map/MapCanvas.tsx・src/components/map/SeriesLayers.tsx・src/lib/map/series-layer.ts・src/components/admin/AnchorDragMap.tsx だけ（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  },
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "依存は src/app から src/lib への一方向なので、src/lib から src/app を import しない（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "web/src/components/map/MapCanvas.*",
        "web/src/components/map/SeriesLayers.*",
        "web/src/lib/map/series-layer.*",
        "web/src/components/admin/AnchorDragMap.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**", "!./**/*.css", "!../**/*.css"],
                    "message": "import は @ 起点の絶対パスで書く（.claude/rules/languages/typescript.md「import」節）"
                  },
                  {
                    "group": ["node:fs", "node:fs/promises"],
                    "message": "node:fs を import してよいのは src/lib/catalog-dir.*・scripts/**・tests/** だけ（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  },
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "依存は src/app から src/lib への一方向なので、src/lib から src/app を import しない（.claude/rules/languages/typescript.project.md「機械が見ている分」）"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
