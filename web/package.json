{
  "name": "coten-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-map-worker": "mkdir -p public && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/",
    "dev": "pnpm sync-map-worker && next dev",
    "build": "pnpm sync-map-worker && next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . && node scripts/lint-comments.ts",
    "test": "pnpm sync-map-worker && vitest run",
    "test:watch": "pnpm sync-map-worker && vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
