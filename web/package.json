{
  "name": "coten-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-map-worker": "mkdir -p public && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/",
    "predev": "pnpm sync-map-worker",
    "dev": "next dev",
    "prebuild": "pnpm sync-map-worker",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . && node scripts/lint-comments.ts",
    "pretest": "pnpm sync-map-worker",
    "test": "vitest run",
    "pretest:watch": "pnpm sync-map-worker",
    "test:watch": "vitest",
    "validate:data": "vitest run tests/data.test.ts",
    "build:scripts": "rm -rf dist && tsc -p tsconfig.scripts.json && tsc-alias -p tsconfig.scripts.json",
    "sync": "pnpm build:scripts && node dist/scripts/sync-feed.js",
    "smoke": "playwright test --project=smoke",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
